        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "cad4cc9b-634d-4bdf-afaa-c19737f28730",
      "name": "IA · Clasificar y redactar (OpenAI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2464,
        528
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "openAiApi": {
          "id": "ou2ye7iKijk7aKZa",
          "name": "OpenAI account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Lee Message.Content de la respuesta de OpenAI y valida el JSON devuelto.\nconst cfg = $('Configuración').item.json;\nconst CATEGORIAS = ['Venta minorista', 'Pedido mayorista', 'Reclamo', 'Consulta de cuidado', 'Spam'];\nconst PRIORIDADES = ['Alta', 'Media', 'Baja'];\nconst SENTIMIENTOS = ['Positivo', 'Neutro', 'Negativo'];\n\nconst content = $json.choices?.[0]?.message?.content ?? '';\ntry {\n  const r = JSON.parse(content);\n  if (!CATEGORIAS.includes(r.categoria)) throw new Error(`Categoría inválida: \"${r.categoria}\"`);\n  const prioridad = PRIORIDADES.includes(r.prioridad) ? r.prioridad : 'Media';\n  const sentimiento = SENTIMIENTOS.includes(r.sentimiento) ? r.sentimiento : 'Neutro';\n  const respuesta = String(r.respuesta || '').trim();\n  if (r.categoria !== 'Spam' && respuesta.length < 20) throw new Error('La IA no devolvió una respuesta utilizable');\n\n  // Semáforo HITL: acciones críticas requieren aprobación humana\n  const requiere_aprobacion =\n    r.categoria === 'Pedido mayorista' || r.categoria === 'Reclamo' ||\n    sentimiento === 'Negativo' || prioridad === 'Alta';\n\n  return { json: {\n    ok: true,\n    categoria: r.categoria,\n    prioridad,\n    sentimiento,\n    resumen: String(r.resumen || '').slice(0, 300),\n    respuesta: respuesta.slice(0, 1900),\n    requiere_aprobacion,\n    es_spam: r.categoria === 'Spam',\n    tokens: Number($json.usage?.total_tokens) || 0,\n    modelo: cfg.modelo,\n  } };\n} catch (e) {\n  return { json: { ok: false, error: e.message, contenido_recibido: String(content).slice(0, 500) } };\n}"
      },
