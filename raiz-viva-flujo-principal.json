    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Lee las propiedades de la página de Notion por su nombre real,\n// valida los datos y aplica MINIMIZACIÓN: la IA nunca recibe email ni teléfono.\nconst cfg = $('Configuración').item.json;\nconst p = $json.properties || {};\n\nconst leer = (nombre) => {\n  const prop = p[nombre];\n  if (!prop) return '';\n  switch (prop.type) {\n    case 'title':        return (prop.title || []).map(t => t.plain_text).join('');\n    case 'rich_text':    return (prop.rich_text || []).map(t => t.plain_text).join('');\n    case 'email':        return prop.email || '';\n    case 'phone_number': return prop.phone_number || '';\n    case 'select':       return prop.select ? prop.select.name : '';\n    case 'number':       return prop.number ?? 0;\n    default:             return '';\n  }\n};\n\nconst email   = String(leer('Email remitente')).trim().toLowerCase();\nconst mensaje = String(leer('Mensaje')).trim();\nconst asunto  = String(leer('Asunto')).trim() || '(sin asunto)';\nconst nombre  = String(leer('Nombre del cliente')).trim();\nconst estado  = String(leer('Estado')).trim();\nconst intentos = Number(leer('Intentos')) || 0;\n\nconst emailValido = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email);\nconst faltantes = [];\nif (!emailValido) faltantes.push('email válido');\nif (mensaje.length < cfg.min_caracteres_mensaje) faltantes.push(`mensaje (mín. ${cfg.min_caracteres_mensaje} caracteres)`);\n\n// Anonimización antes de enviar a la IA\nconst mensajeAnonimizado = mensaje\n  .replace(/[^\\s@]+@[^\\s@]+\\.[^\\s@]+/g, '[EMAIL]')\n  .replace(/\\+?\\d[\\d\\s().-]{7,}\\d/g, '[TEL]')\n  .slice(0, 2000);\n\nreturn {\n  json: {\n    page_id: $json.id,\n    page_url: $json.url,\n    asunto,\n    mensaje,\n    mensaje_anonimizado: mensajeAnonimizado,\n    email,\n    nombre: nombre || email.split('@')[0],\n    primer_nombre: (nombre.split(' ')[0]) || 'cliente',\n    telefono: String(leer('Teléfono')),\n    estado,\n    intentos,\n    datos_completos: faltantes.length === 0,\n    faltantes: faltantes.join(', '),\n    // Filtro anti-bucle: solo se procesa si no fue tocada antes y no superó el máximo de intentos\n    procesable: (estado === '' || estado === 'Pendiente') && intentos < cfg.max_intentos,\n  }\n};"
      },
